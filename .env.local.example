# Copy this file to .env.local and fill in your Supabase values.
#
# How to get these values:
# 1. Open Supabase (https://supabase.com)
# 2. Select project ACCY628-Final-Project-G13 (or your project)
# 3. Open Connect, or go to Settings > API Keys
# 4. Copy the Project URL
# 5. Copy the publishable key
#    If you only see an older "anon" / "anon public" key, use that instead
#
# Do NOT put a service-role key or secret key here.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-public-key

# Stripe (customer Pay bills portal)
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
